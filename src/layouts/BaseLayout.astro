---
import '../styles/global.css';
import '@fontsource/boldonse';
export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Mayank Bairagi – Systems & Graphics Programmer" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://mayankbairagi0312.github.io");
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Mayank Bairagi</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://mayankbairagi0312.github.io/og.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary" />

  <!-- Premium Typefaces -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
</head>
  <body class="min-h-screen p-0 md:p-6 lg:p-8">
    
    <!-- Main structural wrapper box -->
    <div class="max-w-[1080px] mx-auto border-t-0 md:border border-border-dark bg-void-black shadow-none md:shadow-[12px_12px_0px_#0C0C0C] flex flex-col min-h-screen">
      
      <!-- STICKY HEADER -->
      <header class="sticky top-0 z-50 grid grid-cols-1 md:grid-cols-12 border-b-4 border-border-dark font-mono uppercase bg-surface-dark">
        
        <!-- Brand Signature -->
        <div class="p-4   col-span-1 md:col-span-4 border-b md:border-b-0 md:border-r border-border-dark flex items-center bg-surface-dark">
          <a href="/" class="font-black text-lg tracking-tighter hover:text-soviet-red transition-colors">
            MAYANK_BAIRAGI 
          </a>
        </div>

        <!-- Meta status grids -->
        <a href="/#about"
        class="p-4 col-span-1 md:col-span-2 border-b md:border-b-0 md:border-r border-void-black hidden md:flex items-center justify-center text-xs font-bold hover:bg-paper-cream text-paper-cream hover:text-soviet-red transition-colors">
        ABOUT
        </a>

        <!-- Colored Navigation -->
        <nav class="col-span-1 md:col-span-6 grid grid-cols-3 text-center text-xs font-bold ">
          <!-- PROJECTS -->
          <a href="/projects" class="p-4 flex items-center justify-center bg-soviet-red text-white hover:bg-void-black transition-all">
            PROJECTS
          </a>
          <!-- LOGBOOK-->
          <a href="/blog" class="p-4 flex items-center justify-center bg-brutal-yellow text-void-black hover:bg-void-black hover:text-white transition-all">
            LOGBOOK
          </a>
          <!-- GITHUB -->
          <a href="https://github.com/mayankbairagi0312" target="_blank" class="p-4 flex items-center justify-center bg-surface-dark text-paper-cream hover:bg-paper-cream hover:text-void-black transition-all">
            GITHUB ↗
          </a>
        </nav>
      </header>

      <!-- CONTENT BOUNDARY -->
      <slot />

      <!-- FOOTER -->
      <footer class="border-t-4 border-border-dark grid grid-cols-1 md:grid-cols-3 p-6 font-mono text-xs uppercase bg-surface-dark mt-auto">
        <div class="text-gray-500 flex items-center">
          © 2026 MAYANK BAIRAGI. CORE CODEBASE.
        </div>
        <div class="text-left md:text-center text-gray-500 my-4 md:my-0 flex items-center justify-start md:justify-center">
          ENGINE: ASTRO + CSS + ❤️
        </div>
        <div class="md:text-right flex items-center justify-start md:justify-end gap-2">
          COMPILATION: <span class="bg-void-black text-[#00FF41] font-bold px-3 py-1 text-[10px]">SUCCESS</span>
        </div>
      </footer>

    </div>
  </body>
</html>