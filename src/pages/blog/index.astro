---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Get all blog posts, ensuring we filter out drafts
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Engineering Logbook">
  <main class="flex-grow bg-void-black flex flex-col min-h-screen">
   
    <!-- HEADER INTRO SECTION (Simplified & Clean) -->
    <div class="p-8 md:p-12 lg:p-16 border-b-4 border-border-dark bg-surface-dark text-paper-cream relative">
      <div class="max-w-5xl">
        <span class="font-mono text-xs uppercase tracking-widest mb-4 inline-block px-3 py-1 bg-void-black text-paper-cream font-bold">
          // SYS.LOG.ARCHIVE
        </span>
        <h1 class="font-mono font-bold text-4xl md:text-5xl uppercase tracking-tight text-paper-cream mt-2">
          Engineering Log
        </h1>
        <p class="font-mono text-sm text-paper-cream/70 mt-4 max-w-2xl leading-relaxed">
          Technical notes, compiler development journals, computer graphics algorithms, and systems engineering logbooks.
        </p>
      </div>
    </div>

    <!-- POSTS GRID / LIST -->
    <div class="flex-grow max-w-5xl w-full mx-auto px-4 md:px-8 py-12">
      {posts.length > 0 ? (
        <div class="flex flex-col gap-8">
          {posts.map((post) => (
            <article class="bg-surface-dark border-4 border-border-dark shadow-[6px_6px_0px_#2A2A2A] hover:shadow-[10px_10px_0px_#D9281C] transition-all duration-200 group">
              <a href={`/blog/${post.id}`} class="flex flex-col md:flex-row divide-y-4 md:divide-y-0 md:divide-x-4 divide-border-dark h-full">
                
                <!-- Date / Tag Side -->
                <div class="p-6 md:w-1/3 bg-void-black/30 flex flex-col justify-between font-mono text-xs text-paper-cream/50">
                  <div>
                    <span class="block font-bold text-paper-cream">TIMESTAMP</span>
                    <time datetime={post.data.date.toISOString()} class="block text-sm mt-1">
                      {post.data.date.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                      })}
                    </time>
                  </div>
                  <div class="mt-6 md:mt-0">
                    <span class="font-mono text-[10px] uppercase tracking-wider px-2 py-1 bg-void-black text-paper-cream font-bold inline-block">
                      {post.data.tags?.join(" / ") || "SYSTEM"}
                    </span>
                  </div>
                </div>
                
                <!-- Content Side -->
                <div class="p-6 md:p-8 md:w-2/3 flex flex-col justify-between bg-surface-dark group-hover:bg-paper-cream/10 transition-colors">
                  <div>
                    <h2 class="font-mono font-bold text-xl md:text-2xl text-paper-cream uppercase tracking-tight group-hover:text-soviet-red transition-colors mb-3">
                      {post.data.title}
                    </h2>
                    <p class="text-sm text-paper-cream/70 font-sans leading-relaxed mb-6">
                      {post.data.description || "Detailed analysis log detailing current graphics engine developments and algorithmic changes."}
                    </p>
                  </div>
                  <div class="flex items-center gap-1 font-mono text-xs font-bold text-soviet-red">
                    <span>READ SESSION LOG</span>
                    <span class="group-hover:translate-x-1 transition-transform inline-block">→</span>
                  </div>
                </div>

              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="p-16 text-center border-4 border-dashed border-border-dark font-mono text-sm text-paper-cream/50 uppercase">
          NO RECORDS FOUND IN LOGS.
        </div>
      )}
    </div>

  </main>
</BaseLayout>