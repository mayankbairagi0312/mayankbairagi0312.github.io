---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.id }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title}>
  <!-- Light paper background ensuring maximum legibility -->
  <main class="bg-paper-cream min-h-screen text-void-black relative">
    
    <!-- Subtle retro layout stripes -->
    <div class="absolute inset-0 bg-stripes opacity-5 pointer-events-none"></div>
    
    <div class="relative z-10 max-w-3xl mx-auto px-4 md:px-8 py-12 md:py-16 flex flex-col gap-8">
      
      <!-- Back Navigation Button -->
      <a href="/blog" class="font-mono text-xs uppercase text-void-black/60 hover:text-soviet-red underline underline-offset-4 self-start tracking-wider transition-colors font-bold">
        [ ← Return to Archive ]
      </a>
      
      <!-- ARTICLE HEADER -->
      <header class="bg-white border-4 border-void-black p-6 md:p-8 shadow-[8px_8px_0px_#0C0C0C]">
        <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-gray-500 mb-4">
          <time datetime={entry.data.date.toISOString()} class="bg-void-black text-paper-cream px-2 py-0.5 font-bold">
            {entry.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          <span>/</span>
          <span>LOG_ID: {entry.id}</span>
        </div>

        <h1 class="font-mono font-bold text-3xl md:text-5xl uppercase tracking-tight text-void-black border-b-4 border-soviet-red pb-4 mb-4">
          {entry.data.title}
        </h1>

        {entry.data.description && (
          <p class="text-base text-gray-600 font-mono border-l-4 border-soviet-red pl-4 mt-2">
            {entry.data.description}
          </p>
        )}

        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {entry.data.tags.map((t: string) => (
              <span class="font-mono text-xs bg-gray-100 text-void-black px-2.5 py-0.5 border border-void-black font-bold uppercase">
                #{t}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- MARKDOWN RENDER CONTAINER (No white text on white bg) -->
      <article class="bg-white border-4 border-void-black p-6 md:p-10 shadow-[8px_8px_0px_#0C0C0C]">
        <div class="prose max-w-none 
          prose-p:font-sans prose-p:text-void-black/85 prose-p:leading-relaxed prose-p:text-base prose-p:mb-6
          prose-headings:font-mono prose-headings:font-bold prose-headings:uppercase prose-headings:text-void-black prose-headings:tracking-tight prose-headings:mt-8 prose-headings:mb-4
          prose-h2:text-2xl prose-h2:border-b-2 prose-h2:border-gray-200 prose-h2:pb-2
          prose-h3:text-xl
          prose-a:text-soviet-red prose-a:font-bold prose-a:underline hover:bg-soviet-red hover:text-white
          prose-code:bg-gray-100 prose-code:text-soviet-red prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:text-sm prose-code:before:content-none prose-code:after:content-none
          prose-pre:bg-void-black prose-pre:text-paper-cream prose-pre:p-4 prose-pre:border-2 prose-pre:border-void-black prose-pre:shadow-[4px_4px_0px_#D9281C]
          prose-img:border-4 prose-img:border-void-black
          prose-strong:text-void-black prose-strong:font-bold
          prose-ul:list-disc prose-ul:pl-5 prose-ol:list-decimal prose-ol:pl-5
          prose-li:text-void-black/85 prose-li:font-sans prose-li:mb-2
          prose-blockquote:border-l-4 prose-blockquote:border-soviet-red prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:text-gray-600
          prose-hr:border-gray-200">
          <Content />
        </div>
      </article>

      <!-- Back Navigation Bottom -->
      <a href="/blog" class="font-mono text-xs uppercase text-void-black/60 hover:text-soviet-red underline underline-offset-4 self-center tracking-wider transition-colors font-bold mt-4">
        [ ← Return to Archive ]
      </a>

    </div>
  </main>
</BaseLayout>